NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://user:pass@host:5432/elys
DATABASE_SSL=true
JWT_SECRET=<openssl rand -hex 64>
JWT_EXPIRES=8h
PIN_PEPPER=<openssl rand -hex 32>
ARGON2_MEMORY=65536
ARGON2_TIME=3
REDIS_URL=redis://localhost:6379
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=noreply@elyssalon.mx
STORAGE_PATH=/reports
FRONTEND_URL=http://localhost:3000
APP_URL=https://app.elyssalon.mx
TZ=America/El_Salvador
LOW_STOCK_CHECK_CRON=0 8 * * *
ALERT_SNOOZE_REOPEN_CRON=0 * * * *
SLOW_MOVER_DAYS=14
LOCK_TIMEOUT_SEC=120
THROTTLE_LOGIN_TTL=30
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_BLOCK_MIN=5
SYSTEM_USER_PIN=