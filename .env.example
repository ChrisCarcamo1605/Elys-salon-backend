NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://user:password@host:5432/elys
DATABASE_SSL=false

JWT_SECRET=replace_with_openssl_rand_hex_64
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_64
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_COST=12

REDIS_URL=redis://localhost:6379

EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=noreply@elys-salon.com

STORAGE_PATH=/tmp/reports

FRONTEND_URL=http://localhost:3000
APP_URL=https://app.elys-salon.com
TZ=America/El_Salvador

LOW_STOCK_CHECK_CRON=0 8 * * *
PAYROLL_CRON=0 23 15,L * *
EXPENSE_NOTIFY_THRESHOLD=500

SYSTEM_USER_EMAIL=system@elys-salon.local
SYSTEM_USER_PASSWORD=change_me_on_first_seed

THROTTLE_TTL=60
THROTTLE_LIMIT=20
